# ─── Tavily ─────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tavily-api-key-123

# ─── LangFuse ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=changeme-nextauth-secret-32-hex-chars
# Generate with: openssl rand -hex 16
LANGFUSE_SALT=changeme-salt-16-hex-chars
# Generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=changeme-encryption-key-64-hex-chars

# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
LANGFUSE_INIT_ORG_ID=00000000-0000-0000-0000-000000000001
LANGFUSE_INIT_ORG_NAME=AI App Showcase
# Generate with: uuidgen | tr '[:upper:]' '[:lower:]'
LANGFUSE_INIT_PROJECT_ID=00000000-0000-0000-0000-000000000002
LANGFUSE_INIT_PROJECT_NAME=Deep Research
# Generate with: echo "pk-lf-$(openssl rand -hex 16)"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-changeme
# Generate with: echo "sk-lf-$(openssl rand -hex 16)"
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-changeme
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=changeme-password

# Generate with: openssl rand -hex 16
MINIO_ROOT_PASSWORD=changeme-minio-password
# Generate with: openssl rand -hex 16
REDIS_AUTH=changeme-redis-password
# Generate with: openssl rand -hex 16
CLICKHOUSE_PASSWORD=changeme-clickhouse-password

# --- Embabel ---
EMBABEL_LANGFUSE_BASE_URL=http://localhost:3000/api/public/otel
EMBABEL_LANGFUSE_PROJECT_NAME=Deep Research
EMBABEL_LANGFUSE_PROJECT_PUBLIC_KEY=pk-lf-****
EMBABEL_LANGFUSE_PROJECT_SECRET_KEY=sk-lf-****
